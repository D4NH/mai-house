{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "bracketSameLine": true,
    "semi": true,
    "singleAttributePerLine": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 4,
    "printWidth": 100,
    "plugins": ["prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./src/assets/main.css",
    "tailwindFunctions": ["tw"]
}
